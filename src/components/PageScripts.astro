---
// Behaviour shared by story and subject pages: carousels, lightbox, section tabs,
// and share / bookmark / print. Everything works without it; this only adds comfort.
import Icon from "./Icon.astro";
---
<dialog class="lightbox" aria-label="Picture">
  <div class="tools">
    <a class="icon-button" data-lb-page href="#" rel="noopener" aria-label="Open the full record of this picture"><Icon name="expand" /></a>
    <button class="icon-button" type="button" data-lb-close aria-label="Close"><Icon name="close" /></button>
  </div>
  <figure>
    <img alt="" />
    <figcaption><span data-lb-caption></span><span class="credit" data-lb-credit></span></figcaption>
  </figure>
</dialog>

<script is:inline>
  (function () {
    // Carousels: arrow buttons scroll by one view.
    document.querySelectorAll("[data-carousel]").forEach(function (c) {
      var track = c.querySelector(".carousel-track");
      c.querySelectorAll(".carousel-btn").forEach(function (b) {
        b.addEventListener("click", function () {
          track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.85, behavior: "smooth" });
        });
      });
    });

    // Lightbox: the picture large, with caption and credit. Arrow keys move between pictures.
    var dialog = document.querySelector(".lightbox");
    // Pictures can be added later (gallery "Show more"), so the list is read at click time.
    var items = [];
    var current = -1;
    function show(i) {
      var el = items[i]; if (!el) return;
      current = i;
      var img = dialog.querySelector("img");
      img.src = el.dataset.thumb; img.alt = el.dataset.caption;
      var full = new Image(); full.onload = function () { if (current === i) img.src = el.dataset.src; }; full.src = el.dataset.src;
      dialog.querySelector("[data-lb-caption]").textContent = (el.dataset.year ? el.dataset.year + ". " : "") + el.dataset.caption;
      dialog.querySelector("[data-lb-credit]").textContent = el.dataset.credit;
      dialog.querySelector("[data-lb-page]").href = el.dataset.page;
      if (!dialog.open) dialog.showModal();
    }
    document.addEventListener("click", function (e) {
      var el = e.target.closest && e.target.closest("[data-lightbox]");
      if (!el) return;
      items = Array.prototype.slice.call(document.querySelectorAll("[data-lightbox]"));
      show(items.indexOf(el));
    });
    dialog.querySelector("[data-lb-close]").addEventListener("click", function () { dialog.close(); });
    dialog.addEventListener("click", function (e) { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener("keydown", function (e) {
      // Step to the next picture that is actually on show (skips filtered or not-yet-shown ones).
      var step = function (d) { for (var i = current + d; i >= 0 && i < items.length; i += d) if (items[i].offsetParent !== null) return show(i); };
      if (e.key === "ArrowRight") step(1);
      if (e.key === "ArrowLeft") step(-1);
    });

    // Gallery: shelves (then / later), kind chips (pictures, papers...) and "Show more".
    // The page prints the first few items of each shelf; the rest come from a JSON file on first use.
    var esc = function (t) { var d = document.createElement("div"); d.textContent = t == null ? "" : String(t); return d.innerHTML; };
    var kindOf = function (t) { return t === "audio" || t === "video" ? "av" : t; };
    function itemHtml(m) {
      var yr = m.year ? '<span class="yr">' + m.year + "</span>" : "";
      if (m.type === "image") {
        return '<button class="media-item" type="button" data-lightbox data-src="' + esc(m.url) + '" data-thumb="' + esc(m.thumb) + '" data-caption="' + esc(m.caption) + '" data-credit="' + esc(m.credit) + '" data-page="' + esc(m.page) + '" data-year="' + esc(m.year || "") + '">' +
          '<span class="frame"><img src="' + esc(m.thumb) + '" alt="' + esc(m.title) + '" loading="lazy"></span>' +
          '<span class="cap">' + yr + esc(m.caption) + '</span><span class="credit">' + esc(m.credit) + "</span></button>";
      }
      var file = m.type === "document" ? '<a href="' + esc(m.url) + '" class="big" rel="noopener">Read the document</a>'
        : m.type === "audio" ? '<span class="big">Listen</span><audio controls preload="none" src="' + esc(m.url) + '"></audio>'
        : '<video controls preload="none" src="' + esc(m.url) + '"></video>';
      return '<div><div class="media-file">' + file + '</div><span class="media-item" style="cursor:default"><span class="cap">' + yr + esc(m.title) +
        '</span><span class="credit">' + esc(m.credit) + '. <a href="' + esc(m.page) + '" rel="noopener">Details</a></span></span></div>';
    }
    Array.prototype.forEach.call(document.querySelectorAll("[data-gallery]"), function (g) {
      var data = null, loading = null;
      function load() {
        if (data) return Promise.resolve(data);
        loading = loading || fetch(g.dataset.src).then(function (r) { return r.json(); }).then(function (d) { data = d; return d; });
        return loading;
      }
      var tabs = g.querySelectorAll("[data-shelf-tab]");
      Array.prototype.forEach.call(tabs, function (t) {
        t.addEventListener("click", function () {
          Array.prototype.forEach.call(tabs, function (x) { x.setAttribute("aria-selected", String(x === t)); });
          Array.prototype.forEach.call(g.querySelectorAll("[data-shelf]"), function (s) { s.hidden = s.dataset.shelf !== t.dataset.shelfTab; });
        });
      });
      Array.prototype.forEach.call(g.querySelectorAll("[data-shelf]"), function (shelf) {
        var grid = shelf.querySelector(".media-grid");
        var btn = shelf.querySelector(".show-more");
        var page = btn ? Number(btn.dataset.more) : 1e9;
        var total = Number(shelf.dataset.total);
        var full = grid.children.length >= total; // everything already printed
        var kind = "all", shown = page;
        function paint() {
          var lis = Array.prototype.slice.call(grid.children);
          var match = lis.filter(function (li) { return kind === "all" || li.dataset.type === kind; });
          lis.forEach(function (li) { li.hidden = true; });
          match.slice(0, shown).forEach(function (li) { li.hidden = false; });
          if (btn) {
            var left = Math.max(0, match.length - shown);
            btn.parentNode.hidden = left === 0;
            btn.querySelector("[data-left]").textContent = left;
          }
        }
        function ensureAll() {
          if (full) return Promise.resolve();
          if (btn) btn.disabled = true;
          return load().then(function (d) {
            grid.innerHTML = d[shelf.dataset.shelf].map(function (m) { return '<li data-type="' + kindOf(m.type) + '">' + itemHtml(m) + "</li>"; }).join("");
            full = true;
            if (btn) btn.disabled = false;
          }).catch(function () { if (btn) btn.disabled = false; });
        }
        if (btn) btn.addEventListener("click", function () { ensureAll().then(function () { shown += page; paint(); }); });
        Array.prototype.forEach.call(shelf.querySelectorAll("[data-kind]"), function (c) {
          c.addEventListener("click", function () {
            Array.prototype.forEach.call(shelf.querySelectorAll("[data-kind]"), function (x) { x.setAttribute("aria-pressed", String(x === c)); });
            kind = c.dataset.kind; shown = page;
            ensureAll().then(paint);
          });
        });
      });
    });

    // Section tabs: underline the section you are reading.
    var tabLinks = Array.prototype.slice.call(document.querySelectorAll(".tabs a[href^='#']"));
    var sections = tabLinks.map(function (a) { return document.getElementById(a.getAttribute("href").slice(1)); }).filter(Boolean);
    if (sections.length && "IntersectionObserver" in window) {
      var visible = new Map();
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { visible.set(e.target.id, e.isIntersecting); });
        var first = sections.find(function (s) { return visible.get(s.id); });
        if (!first) return;
        tabLinks.forEach(function (a) { a.setAttribute("aria-current", String(a.getAttribute("href") === "#" + first.id)); });
      }, { rootMargin: "-140px 0px -55% 0px" });
      sections.forEach(function (s) { io.observe(s); });
    }

    // Share: the phone's share sheet if there is one, otherwise copy the link.
    var share = document.querySelector("[data-share]");
    if (share) share.addEventListener("click", function () {
      var data = { title: document.title, url: location.href };
      if (navigator.share) { navigator.share(data).catch(function () {}); return; }
      navigator.clipboard && navigator.clipboard.writeText(location.href).then(function () {
        share.setAttribute("aria-label", "Link copied"); share.title = "Link copied";
      });
    });

    // Bookmark: saved on this device only.
    var mark = document.querySelector("[data-bookmark]");
    if (mark) {
      var key = "bookmarks", id = mark.dataset.bookmark;
      var read = function () { try { return JSON.parse(localStorage.getItem(key) || "[]"); } catch (e) { return []; } };
      var paint = function () {
        var on = read().indexOf(id) > -1;
        mark.setAttribute("aria-pressed", String(on));
        mark.setAttribute("aria-label", on ? "Remove bookmark" : "Bookmark this story");
      };
      mark.addEventListener("click", function () {
        var list = read(), i = list.indexOf(id);
        if (i > -1) list.splice(i, 1); else list.push(id);
        try { localStorage.setItem(key, JSON.stringify(list)); } catch (e) {}
        paint();
      });
      paint();
    }

    var print = document.querySelector("[data-print]");
    if (print) print.addEventListener("click", function () { window.print(); });
  })();
</script>
