---
import type { Subject } from "../lib/site";
import { datesOf } from "../lib/site";

interface Props {
  subject: Subject;
  label: string;
  heading: string;
  title?: string;
  dek?: string;
  quote?: { text: string; by: string };
  image?: Subject["data"]["image"];
}
const { subject, label, heading, title, dek, quote, image } = Astro.props;
const dates = datesOf(subject);
---
<header class="hero">
  <div>
    <span class="label">{label}</span>
    <h1 class="hero-name">{heading}</h1>
    {title && <p class="hero-title">{title}</p>}
    {dek && <p class="hero-dek">{dek}</p>}
    {quote && (
      <blockquote class="hero-quote">
        <p>“{quote.text}”</p>
        <footer>— {quote.by}</footer>
      </blockquote>
    )}
    <dl class="hero-meta">
      {dates && <><dt class="label">Dates</dt><dd>{dates}</dd></>}
      {subject.data.region && <><dt class="label">Region</dt><dd>{subject.data.region}</dd></>}
    </dl>
  </div>
  <figure class="portrait">
    {image ? (
      <>
        <img src={image.src} alt={image.alt} loading="eager" />
        <figcaption>
          {image.caption}
          <span class="credit">
            {image.credit}{image.license && ` · ${image.license}`}
            {image.sourceUrl && <> · <a href={image.sourceUrl} rel="noopener">source</a></>}
          </span>
        </figcaption>
      </>
    ) : (
      <div class="portrait-empty" aria-hidden="true">{subject.data.name.charAt(0)}</div>
    )}
  </figure>
</header>
