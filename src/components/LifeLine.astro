---
// Places a story on the 190-year line from Plassey (1757) to Independence (1947).
interface Props {
  from: number;
  to?: number;
}
const START = 1757;
const END = 1947;
const W = 600;
const { from, to } = Astro.props;
const x = (y: number) => ((Math.min(Math.max(y, START), END) - START) / (END - START)) * W;
const decades = Array.from({ length: 19 }, (_, i) => 1760 + i * 10);
const labels = [1757, 1800, 1857, 1900, 1947];
const isSpan = to !== undefined && to !== from;
const caption = isSpan
  ? `${from} to ${to}, on the line from Plassey to Independence`
  : `${from}, on the line from Plassey to Independence`;
---
<figure class="lifeline">
  <svg viewBox={`-8 0 ${W + 16} 52`} role="img" aria-label={caption}>
    <line class="axis" x1="0" y1="18" x2={W} y2="18" />
    {decades.map((d) => <line class="tick" x1={x(d)} y1="15" x2={x(d)} y2="21" />)}
    {labels.map((l, i) => (
      <text x={x(l)} y="44" text-anchor={i === 0 ? "start" : i === labels.length - 1 ? "end" : "middle"}>{l}</text>
    ))}
    {isSpan ? (
      <line class="span" x1={x(from)} y1="18" x2={x(to!)} y2="18" />
    ) : (
      <circle class="dot" cx={x(from)} cy="18" r="5" />
    )}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
