---
import type { Subject } from "../lib/site";
import { formatDate } from "../lib/years";

interface Props {
  subject: Subject;
  moments?: string[];
  people?: string[];
}
const { subject, moments = [], people = [] } = Astro.props;
const d = subject.data;
const facts = (d.kind === "person"
  ? [
      ["Born", formatDate(d.born)],
      ["Died", formatDate(d.died)],
      ["Region", d.region],
      ["Known as", d.role ?? ""],
      ["Places", d.places.join(" · ")],
      ["Key moments", moments.slice(0, 3).join(" · ")],
    ]
  : [
      ["Date", formatDate(d.date)],
      ["Region", d.region],
      ["Places", d.places.join(" · ")],
      ["People involved", people.slice(0, 4).join(" · ")],
    ]
).filter(([, v]) => v);
---
{facts.length > 0 && (
  <section class="quick-facts" aria-labelledby="qf">
    <div class="quick-facts-head"><h2 id="qf" class="label">Quick facts: {d.name}</h2></div>
    <ol class="facts-grid">
      {facts.map(([k, v]) => <li><div><span class="label">{k}</span><strong>{v}</strong></div></li>)}
    </ol>
  </section>
)}
