---
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import StoryCard from "./StoryCard.astro";
import SubjectRow from "./SubjectRow.astro";
import MediaItem from "./MediaItem.astro";
import PageScripts from "./PageScripts.astro";
import { loadSite, datesOf, KINDS, type Subject } from "../lib/site";
import { formatDate } from "../lib/years";

interface Props { subject: Subject }
const { subject } = Astro.props;
const site = await loadSite();
const d = subject.data;
const kind = KINDS[d.kind];

const written = site.mainStoriesOf(subject.id);
const appears = site.appearsInOf(subject.id);
const planned = d.angles.filter((a) => !a.story);
const media = site.mediaOf(subject.id);
const related = d.related.map((id) => site.subjectById.get(id)).filter((s) => s !== undefined);
const connections = {
  people: related.filter((s) => s.data.kind === "person"),
  events: related.filter((s) => s.data.kind === "event").sort((a, b) => a.data.year - b.data.year),
  places: related.filter((s) => s.data.kind === "place"),
  groups: related.filter((s) => s.data.kind === "organisation"),
};
const dates = datesOf(subject);

const facts = ({
  person: [["Born", formatDate(d.born)], ["Died", formatDate(d.died)], ["From", d.region], ["Known as", d.role ?? ""]],
  event: [["When", formatDate(d.date)], ["Where", d.region], ["Places", d.places.join(", ")]],
  place: [["Region", d.region], ["Kind of place", d.placeType ?? ""]],
  organisation: [["Founded", d.founded ?? ""], ["Ended", d.ended ?? ""], ["Also called", d.aliases ?? ""], ["Active in", d.region]],
}[d.kind] as [string, string][]).filter(([, v]) => v);

const hasStories = written.length + appears.length > 0;
const tabs = [
  ["stories", "Stories"],
  media.original.length + media.later.length > 0 && ["gallery", "Pictures and papers"],
  related.length > 0 && ["connections", "Connections"],
  d.sources.length > 0 && ["sources", "Sources"],
].filter(Boolean) as [string, string][];

const jsonLd = d.kind === "person"
  ? { "@context": "https://schema.org", "@type": "Person", name: d.name, description: d.summary, birthDate: d.born || undefined, deathDate: d.died || undefined, image: d.image ? new URL(d.image.src, Astro.site).toString() : undefined }
  : { "@context": "https://schema.org", "@type": d.kind === "organisation" ? "Organization" : d.kind === "place" ? "Place" : "Event", name: d.name, description: d.summary };
---
<Base
  title={`${d.name}: stories from India's freedom struggle`}
  description={d.summary || `Stories, pictures and papers about ${d.name}.`}
  image={d.image?.src}
  type={d.kind === "person" ? "profile" : "website"}
  section={kind.path}
  noindex={!hasStories}
  jsonLd={jsonLd}
>
  <div class="page">
    <ol class="crumbs" aria-label="Breadcrumb">
      <li><a href="/">Home</a></li>
      <li><a href={`/${kind.path}/`}>{kind.plural}</a></li>
      <li aria-current="page">{d.name}</li>
    </ol>

    <header class="subject-head" data-pagefind-body>
      <div>
        <span class="kind">{d.role ?? kind.one}</span>
        <h1>{d.name}</h1>
        {dates && <p class="years">{dates}</p>}
        {d.summary && <p class="summary">{d.summary}</p>}
      </div>
      {d.image && (
        <figure class="portrait">
          <img src={d.image.src} alt={d.image.alt} />
          <figcaption>{[d.image.credit, d.image.license].filter(Boolean).join(", ")}{d.image.sourceUrl && <>. <a href={d.image.sourceUrl} rel="noopener">Source</a></>}</figcaption>
        </figure>
      )}
    </header>

    {facts.length > 0 && <dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}

    <nav class="tabs no-print" aria-label={`About ${d.name}`}>
      <ul>{tabs.map(([id, label], i) => <li><a href={`#${id}`} aria-current={i === 0 ? "true" : "false"}>{label}</a></li>)}</ul>
    </nav>

    <section class="section" id="stories">
      <div class="section-head">
        <div>
          <h2>Stories</h2>
          <p>{written.length > 0 ? "Start with the big story, then pick any short one." : hasStories ? `${d.name} appears in these stories.` : `We haven't written ${d.name}'s story yet.`}</p>
        </div>
      </div>
      {written.filter((s) => s.data.type === "flagship").map((s) => <StoryCard story={s} wide showWho={false} />)}
      {written.filter((s) => s.data.type === "short").length > 0 && (
        <ul class="cards" style="margin-top:1.25rem">{written.filter((s) => s.data.type === "short").map((s) => <li><StoryCard story={s} showWho={false} /></li>)}</ul>
      )}
      {appears.length > 0 && (
        <>
          {written.length > 0 && <h3 style="margin:2rem 0 1rem;font-size:1.1rem">{d.name} also appears in</h3>}
          <ul class="cards">{appears.map((s) => <li><StoryCard story={s} /></li>)}</ul>
        </>
      )}
      {planned.length > 0 && (
        <>
          <h3 style="margin:2.25rem 0 0;font-size:1.1rem">Stories on the way</h3>
          <ul class="coming">
            {planned.map((a) => <li><span class="h">{a.type === "flagship" ? "Flagship story" : "Short story"}, coming soon</span><strong>{a.title}</strong><p>{a.hook}</p></li>)}
          </ul>
        </>
      )}
    </section>

    {media.original.length + media.later.length > 0 && (
      <section class="section" id="gallery">
        <div class="section-head">
          <div>
            <h2>Pictures and papers</h2>
            <p>{media.original.length > 0 ? `Photographs, letters and documents from ${d.kind === "person" ? `${d.name}'s own lifetime` : "the time"}.` : "Pictures of memorials and places that remember this history."}</p>
          </div>
        </div>
        {(() => {
          // Two shelves: from the subject's own time, and how they were remembered later.
          // Each prints PAGE items; "Show more" and the filters load the rest from /media/<id>.json (see PageScripts).
          const PAGE = 24;
          const shelves = [
            { id: "then", label: d.kind === "person" ? "From his or her lifetime" : "From the time", items: media.original },
            { id: "later", label: "How India remembers", items: media.later },
          ].filter((s) => s.items.length);
          const kinds = (items: typeof media.original) => [
            ["all", "All"],
            ["image", "Pictures"],
            ["document", "Papers"],
            ["av", "Sound and film"],
          ].filter(([k]) => k === "all" || items.some((i) => (k === "av" ? i.type === "audio" || i.type === "video" : i.type === k)));
          const kindOf = (t: string) => (t === "audio" || t === "video" ? "av" : t);
          return (
            <div class="gallery" data-gallery data-src={`/media/${subject.id}.json`}>
              {shelves.length > 1 && (
                <div class="shelf-tabs" role="tablist">
                  {shelves.map((s, i) => (
                    <button type="button" role="tab" aria-selected={String(i === 0)} data-shelf-tab={s.id}>
                      {s.id === "then" && d.kind === "person" ? `From ${d.name}'s lifetime` : s.label} <span class="n">{s.items.length}</span>
                    </button>
                  ))}
                </div>
              )}
              {shelves.map((s, i) => (
                <div class="shelf" data-shelf={s.id} data-total={s.items.length} hidden={i > 0}>
                  {kinds(s.items).length > 2 && (
                    <div class="kind-chips">
                      {kinds(s.items).map(([k, label], j) => <button type="button" aria-pressed={String(j === 0)} data-kind={k}>{label}</button>)}
                    </div>
                  )}
                  <ul class="media-grid">
                    {s.items.slice(0, PAGE).map((m) => <li data-type={kindOf(m.type)}><MediaItem item={m} /></li>)}
                  </ul>
                  {s.items.length > PAGE && (
                    <p class="show-more-row"><button type="button" class="show-more" data-more={PAGE}>Show more <span data-left>{s.items.length - PAGE}</span> left</button></p>
                  )}
                </div>
              ))}
              <noscript><style>{`.shelf[hidden]{display:block!important}.show-more-row,.shelf-tabs,.kind-chips{display:none}`}</style></noscript>
            </div>
          );
        })()}
        <p class="fine-print">From Wikimedia Commons and Wikipedia. We only show files anyone is free to reuse; each names who made it and its licence. Tap a picture to see it large.</p>
      </section>
    )}

    {related.length > 0 && (
      <section class="section" id="connections">
        <div class="section-head"><h2>Connections</h2></div>
        {Object.entries(connections).filter(([, list]) => list.length).map(([group, list]) => (
          <>
            <h3 style="margin:1.5rem 0 0.5rem;font-size:1rem;color:var(--soft)">{({ people: "People", events: "Events", places: "Places", groups: "Groups and organisations" } as Record<string, string>)[group]}</h3>
            <ul class="people-grid">{list.map((s) => <li><SubjectRow subject={s} /></li>)}</ul>
          </>
        ))}
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="section sources" id="sources">
        <div class="section-head"><h2>Where we found the facts</h2></div>
        <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span style="color:var(--soft)">. {s.publisher}</span>}</li>)}</ol>
      </section>
    )}
  </div>
  <PageScripts />
</Base>
