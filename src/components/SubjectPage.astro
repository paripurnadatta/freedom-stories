---
import Base from "../layouts/Base.astro";
import Plate from "./Plate.astro";
import { loadSite, hubUrl, storyUrl, datesOf, cleanCredit, shortCaption, type Subject } from "../lib/site";
import { formatDate } from "../lib/years";

interface Props { subject: Subject }
const { subject } = Astro.props;
const site = await loadSite();
const d = subject.data;

const written = site.mainStoriesOf(subject.id);
const appears = site.appearsInOf(subject.id);
const planned = d.angles.filter((a) => !a.story);
const media = site.mediaOf(subject.id);
const pictures = (list: typeof media.original) => list.filter((m) => m.type === "image");
const papers = (list: typeof media.original) => list.filter((m) => m.type !== "image");

const related = d.related.map((id) => site.subjectById.get(id)).filter((s) => s !== undefined);
const connected = related.filter((p) => site.hasHub(p.id));
const dates = datesOf(subject);

const facts = (d.kind === "person"
  ? [["Born", formatDate(d.born)], ["Died", formatDate(d.died)], ["From", d.region], ["Known as", d.role ?? ""], ["Places in the story", d.places.join(", ")]]
  : [["When", formatDate(d.date)], ["Where", [d.region, ...d.places].filter(Boolean).join(", ")]]
).filter(([, v]) => v);

const credit = (m: { author: string; license: string }) => cleanCredit(m.author, m.license);
const cap = (m: { description: string; title: string }) => shortCaption(m.description, m.title);
const dims = (m: { width?: number; height?: number }) => (m.width && m.height ? { width: 500, height: Math.round((500 * m.height) / m.width) } : {});
---
<Base title={`${d.name}: stories from India's freedom struggle`} description={d.summary}>
  <main class="wide">
    <header class="cover">
      <div>
        <h1>{d.name}</h1>
        {dates && <p class="years">{dates}</p>}
        {d.summary && <p class="summary">{d.summary}</p>}
      </div>
      {d.image && <Plate image={d.image} portrait />}
    </header>

    {facts.length > 0 && (
      <dl class="facts">{facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    )}

    <h2 class="chapter-head">
      Stories
      <small>{written.length > 0 ? "Start with the big story, then pick any short one." : `${d.name} appears in these stories.`}</small>
    </h2>
    <ol class="contents">
      {written.map((s) => (
        <li class:list={{ flag: s.data.type === "flagship" }}>
          <a href={storyUrl(s)}>
            <span>
              <span class="kind">{s.data.type === "flagship" ? "The big story" : "Short story"}</span>
              <span class="t">{s.data.title}</span>
              <span class="h">{s.data.subtitle}</span>
            </span>
          </a>
        </li>
      ))}
      {appears.map((s) => {
        const lead = site.subjectById.get(s.data.about[0]);
        return (
          <li>
            <a href={storyUrl(s)}>
              <span>
                <span class="kind">From {lead?.data.name}'s story</span>
                <span class="t">{s.data.title}</span>
                <span class="h">{s.data.subtitle}</span>
              </span>
            </a>
          </li>
        );
      })}
      {planned.map((a) => (
        <li>
          <div class="later">
            <span>
              <span class="kind">Coming soon</span>
              <span class="t">{a.title}</span>
              <span class="h">{a.hook}</span>
            </span>
          </div>
        </li>
      ))}
    </ol>

    {(media.original.length > 0 || media.later.length > 0) && (
      <section>
        <h2 class="chapter-head">
          Pictures and papers
          <small>Photographs, letters and documents, most of them from {d.kind === "person" ? `${d.name}'s own lifetime` : "the time"}.</small>
        </h2>

        {pictures(media.original).length > 0 && (
          <ul class="gallery">
            {pictures(media.original).map((m) => (
              <li>
                <a href={m.page} rel="noopener">
                  <img src={m.thumb ?? m.url} alt={m.title} loading="lazy" {...dims(m)} />
                  <span class="cap">{m.year && <span class="yr">{m.year}</span>}{cap(m)}</span>
                  <span class="credit">{credit(m)}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {papers(media.original).length > 0 && (
          <ul class="gallery">
            {papers(media.original).map((m) => (
              <li>
                <div class:list={[m.type === "document" ? "doc" : "snd"]}>
                  {m.type === "document" && <a href={m.url} rel="noopener"><span class="doc-mark">Read the document</span></a>}
                  {m.type === "audio" && <audio controls preload="none" src={m.url}></audio>}
                  {m.type === "video" && <video controls preload="none" src={m.url} style="width:100%"></video>}
                  <span class="cap">{m.year && <span class="yr">{m.year}</span>}{m.title}</span>
                  <span class="credit">{credit(m)}. <a href={m.page} rel="noopener">Details</a></span>
                </div>
              </li>
            ))}
          </ul>
        )}

        {media.later.length > 0 && (
          <details class="more-media">
            <summary>How India remembers {d.name} <span>({media.later.length} pictures of statues, memorials and places)</span></summary>
            <ul class="gallery">
              {media.later.map((m) => (
                <li>
                  <a href={m.page} rel="noopener">
                    {m.type === "image" ? <img src={m.thumb ?? m.url} alt={m.title} loading="lazy" {...dims(m)} /> : null}
                    <span class="cap">{m.year && <span class="yr">{m.year}</span>}{cap(m)}</span>
                    <span class="credit">{credit(m)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <p class="small-print">
          These come from Wikimedia Commons and Wikipedia. We only show files that anyone is free to reuse, and each one names who made it and its licence.
          Tap any picture to see its full record.
        </p>
      </section>
    )}

    {connected.length > 0 && (
      <section>
        <h2 class="chapter-head">People and moments around {d.name}</h2>
        <ul class="people-row">
          {connected.map((p) => (
            <li>
              <a href={hubUrl(p)}>
                <span class="face">{p.data.image ? <img src={p.data.image.src} alt="" loading="lazy" /> : p.data.name.charAt(0)}</span>
                <span><span class="who">{p.data.name}</span><span class="what">{p.data.kind === "event" ? p.data.year : p.data.role}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="after" style="padding-top:0">
        <h2 class="chapter-head">Where we found the facts</h2>
        <ol class="sources">
          {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span class="pub">. {s.publisher}</span>}</li>)}
        </ol>
      </section>
    )}
  </main>
</Base>
