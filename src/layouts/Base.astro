---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  section?: "stories" | "people" | "events" | "places" | "organisations";
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = "True stories of the people who fought for India's freedom, from Plassey in 1757 to Independence in 1947, told for young readers.",
  image,
  type = "website",
  noindex = false,
  section,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
const nav = [
  ["stories", "/stories/", "Stories"],
  ["people", "/people/", "People"],
  ["events", "/events/", "Events"],
  ["places", "/places/", "Places"],
  ["organisations", "/organisations/", "Organisations"],
] as const;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="The Struggle for Freedom" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11152b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;0,7..72,800;1,7..72,400&display=swap"
    />
    <script is:inline>
      // Pick day or night before the page paints, so it never flashes the wrong colours.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the story</a>
    <span class="tricolour" aria-hidden="true"></span>
    <header class="site-header">
      <div class="page bar">
        <a class="logo" href="/" aria-label="The Struggle for Freedom, home">
          <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="logo-words"><span class="a">The Struggle</span><br /><span class="b">for Freedom</span></span>
        </a>
        <nav class="primary-nav" aria-label="Main">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="header-tools">
          <form class="search-box in-header" action="/search/" role="search">
            <Icon name="search" />
            <label class="visually-hidden" for="q-header">Search stories, people, events and places</label>
            <input id="q-header" name="q" type="search" placeholder="Search stories, people, places" />
          </form>
          <a class="icon-button search-link" href="/search/" aria-label="Search"><Icon name="search" /></a>
          <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to night reading">
            <span data-when="light"><Icon name="moon" /></span>
            <span data-when="dark" hidden><Icon name="sun" /></span>
          </button>
          <button class="icon-button menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle aria-label="Open menu">
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu">
        <nav class="page" aria-label="Main">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? "page" : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <span class="tricolour" aria-hidden="true"></span>
      <div class="page">
        <div>
          <a class="logo" href="/">
            <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="logo-words"><span class="a">The Struggle</span><br /><span class="b">for Freedom</span></span>
          </a>
          <p style="margin-top:0.9rem">True stories of India's freedom struggle, 1757 to 1947, for young readers. Every story says where its facts come from.</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>{nav.map(([, href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h2>About the pictures</h2>
          <p>Photographs and papers come from Wikimedia Commons and are free to reuse. Each one names who made it and its licence. Painted illustrations are made for this site.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        // Day / night
        var themeButton = document.querySelector("[data-theme-toggle]");
        function showTheme() {
          var dark = root.dataset.theme === "dark";
          themeButton.querySelector('[data-when="light"]').hidden = dark;
          themeButton.querySelector('[data-when="dark"]').hidden = !dark;
          themeButton.setAttribute("aria-label", dark ? "Switch to day reading" : "Switch to night reading");
        }
        themeButton.addEventListener("click", function () {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
          showTheme();
        });
        showTheme();

        // Mobile menu
        var menuButton = document.querySelector("[data-menu-toggle]");
        var menu = document.getElementById("mobile-menu");
        menuButton.addEventListener("click", function () {
          var open = menuButton.getAttribute("aria-expanded") !== "true";
          menuButton.setAttribute("aria-expanded", String(open));
          menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          if (open) menu.setAttribute("data-open", ""); else menu.removeAttribute("data-open");
        });
      })();
    </script>
  </body>
</html>
