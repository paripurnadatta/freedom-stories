---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  section?: "stories" | "people" | "events" | "places" | "organisations" | "connections";
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = "True stories of the people who fought for India's freedom, from Plassey in 1757 to Independence in 1947, told for young readers.",
  image,
  type = "website",
  noindex = false,
  section,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
const nav = [
  ["stories", "/stories/", "Stories"],
  ["people", "/people/", "People"],
  ["events", "/events/", "Events"],
  ["places", "/places/", "Places"],
  ["organisations", "/organisations/", "Organisations"],
  ["connections", "/connections/", "Connections"],
] as const;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="The Struggle for Freedom" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11152b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;0,7..72,800;1,7..72,400&display=swap"
    />
    <script is:inline>
      // Pick day or night before the page paints, so it never flashes the wrong colours.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the story</a>
    <span class="tricolour" aria-hidden="true"></span>
    <header class="site-header">
      <div class="page bar">
        <a class="logo" href="/" aria-label="The Struggle for Freedom, home">
          <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="logo-words"><span class="a">The Struggle</span><br /><span class="b">for Freedom</span></span>
        </a>
        <nav class="primary-nav" aria-label="Main">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="header-tools">
          <form class="search-box in-header" action="/search/" role="search">
            <Icon name="search" />
            <label class="visually-hidden" for="q-header">Search stories, people, events and places</label>
            <input id="q-header" name="q" type="search" placeholder="Search stories, people, places" data-suggest autocomplete="off" />
          </form>
          <a class="icon-button search-link" href="/search/" aria-label="Search"><Icon name="search" /></a>
          <button class="icon-button" type="button" data-theme-toggle aria-label="Switch to night reading">
            <span data-when="light"><Icon name="moon" /></span>
            <span data-when="dark" hidden><Icon name="sun" /></span>
          </button>
          <button class="icon-button menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle aria-label="Open menu">
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <div class="mobile-menu" id="mobile-menu">
        <nav class="page" aria-label="Main">
          {nav.map(([key, href, label]) => <a href={href} aria-current={section === key ? "page" : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <span class="tricolour" aria-hidden="true"></span>
      <div class="page">
        <div>
          <a class="logo" href="/">
            <span class="logo-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="logo-words"><span class="a">The Struggle</span><br /><span class="b">for Freedom</span></span>
          </a>
          <p style="margin-top:0.9rem">True stories of India's freedom struggle, 1757 to 1947, for young readers. Every story says where its facts come from.</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>{nav.map(([, href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h2>About the pictures</h2>
          <p>Photographs and papers come from Wikimedia Commons and are free to reuse. Each one names who made it and its licence. Painted illustrations are made for this site.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Instant suggestions under any search box marked data-suggest: names first, then stories.
      (function () {
        var inputs = document.querySelectorAll("input[data-suggest]");
        if (!inputs.length) return;
        var data = null, loading = null;
        function load() {
          if (data) return Promise.resolve(data);
          loading = loading || fetch("/search-index.json").then(function (r) { return r.json(); }).then(function (j) { data = j; return j; }).catch(function () { data = []; return data; });
          return loading;
        }
        function norm(s) { return String(s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9\s]/g, " ").replace(/\s+/g, " ").trim(); }
        function esc(s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
        function score(e, q, words) {
          var names = [e.n].concat(e.a || []).map(norm), best = 0;
          names.forEach(function (n) {
            if (n === q) best = Math.max(best, 100);
            else if (n.indexOf(q) === 0) best = Math.max(best, 80);
            else if (n.split(" ").some(function (w) { return w.indexOf(q) === 0; })) best = Math.max(best, 60);
            else if (words.every(function (w) { return n.indexOf(w) !== -1; })) best = Math.max(best, 40);
          });
          if (!best && words.every(function (w) { return norm(e.s).indexOf(w) !== -1 || norm(e.n).indexOf(w) !== -1; })) best = 20;
          return best;
        }
        inputs.forEach(function (input) {
          var box = input.closest(".search-box") || input.parentElement;
          var list = document.createElement("ul");
          list.className = "suggest"; list.hidden = true; list.setAttribute("role", "listbox");
          list.id = "suggest-" + input.id;
          box.appendChild(list);
          input.setAttribute("role", "combobox"); input.setAttribute("aria-expanded", "false"); input.setAttribute("aria-controls", list.id); input.setAttribute("aria-autocomplete", "list");
          var active = -1;
          function close() { list.hidden = true; input.setAttribute("aria-expanded", "false"); active = -1; }
          function mark() {
            Array.prototype.forEach.call(list.children, function (li, i) { li.setAttribute("aria-selected", i === active ? "true" : "false"); });
          }
          function render(q) {
            var nq = norm(q), words = nq.split(" ").filter(Boolean);
            if (nq.length < 2) return close();
            load().then(function (idx) {
              if (norm(input.value) !== nq) return;
              var hits = idx.map(function (e) { return { e: e, s: score(e, nq, words) }; }).filter(function (x) { return x.s > 0; });
              hits.sort(function (a, b) { return b.s - a.s || (a.e.k === "story") - (b.e.k === "story"); });
              var subj = hits.filter(function (x) { return x.e.k !== "story"; }).slice(0, 3);
              var stor = hits.filter(function (x) { return x.e.k === "story"; }).slice(0, 6 - subj.length);
              var rows = subj.concat(stor);
              if (!rows.length) return close();
              list.innerHTML = rows.map(function (x) {
                var e = x.e, isStory = e.k === "story";
                var thumb = e.i ? '<span class="sg-thumb' + (isStory ? "" : " round") + '"><img src="' + esc(e.i) + '" alt="" loading="lazy" />' + (e.p ? '<span class="sg-ai">AI</span>' : "") + "</span>" : '<span class="sg-thumb' + (isStory ? "" : " round") + '"></span>';
                var sub = isStory ? "Story" + (e.s ? " \u00b7 " + esc(e.s) : "") : esc(e.s);
                return '<li role="option" aria-selected="false"><a href="' + esc(e.u) + '">' + thumb + '<span><span class="sg-t">' + esc(e.n) + '</span><span class="sg-s">' + sub + "</span></span></a></li>";
              }).join("") + '<li class="sg-all" role="option"><a href="/search/?q=' + encodeURIComponent(q.trim()) + '">See all results for \u201c' + esc(q.trim()) + "\u201d</a></li>";
              list.hidden = false; input.setAttribute("aria-expanded", "true"); active = -1;
            });
          }
          input.addEventListener("focus", load);
          input.addEventListener("input", function () { render(input.value); });
          input.addEventListener("keydown", function (e) {
            if (list.hidden) return;
            var n = list.children.length;
            if (e.key === "ArrowDown") { e.preventDefault(); active = (active + 1) % n; mark(); }
            else if (e.key === "ArrowUp") { e.preventDefault(); active = (active - 1 + n) % n; mark(); }
            else if (e.key === "Escape") { close(); }
            else if (e.key === "Enter" && active >= 0) { e.preventDefault(); var a = list.children[active].querySelector("a"); if (a) location.href = a.href; }
          });
          document.addEventListener("click", function (e) { if (!box.contains(e.target)) close(); });
          input.form && input.form.addEventListener("submit", close);
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // Day / night
        var themeButton = document.querySelector("[data-theme-toggle]");
        function showTheme() {
          var dark = root.dataset.theme === "dark";
          themeButton.querySelector('[data-when="light"]').hidden = dark;
          themeButton.querySelector('[data-when="dark"]').hidden = !dark;
          themeButton.setAttribute("aria-label", dark ? "Switch to day reading" : "Switch to night reading");
        }
        themeButton.addEventListener("click", function () {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem("theme", root.dataset.theme); } catch (e) {}
          showTheme();
        });
        showTheme();

        // Mobile menu
        var menuButton = document.querySelector("[data-menu-toggle]");
        var menu = document.getElementById("mobile-menu");
        menuButton.addEventListener("click", function () {
          var open = menuButton.getAttribute("aria-expanded") !== "true";
          menuButton.setAttribute("aria-expanded", String(open));
          menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          if (open) menu.setAttribute("data-open", ""); else menu.removeAttribute("data-open");
        });
      })();
    </script>
  </body>
</html>
