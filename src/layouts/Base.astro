---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  crumb?: string;
}
const { title, crumb, description = "Stories of India's freedom struggle, from Plassey in 1757 to Independence in 1947." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1020" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
    />
  </head>
  <body>
    <div class="tricolour-bar"></div>
    <header class="site-header">
      <div class="page">
        <a class="brand" href="/">
          <span class="brand-years">INDIA 1757–1947</span>
          <span class="brand-name">The Struggle<br />for Freedom</span>
        </a>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">All stories</a>
          {crumb && <><span>/</span><span aria-current="page">{crumb}</span></>}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="page">Stories of India's freedom struggle, 1757 to 1947. Every story lists its sources.</div>
    </footer>
  </body>
</html>
