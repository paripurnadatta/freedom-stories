---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import { loadSite, hubUrl, storyUrl, type Story } from "../../lib/site";

export async function getStaticPaths() {
  const site = await loadSite();
  return site.stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
const site = await loadSite();
const d = story.data;
const { Content, headings } = await render(story);
const sections = headings.filter((h) => h.depth === 2);

const main = site.subjectById.get(d.about[0])!;
const others = d.about.slice(1).map((id) => site.subjectById.get(id)).filter((s) => s !== undefined);
const people = others.filter((s) => s.data.kind === "person");
const moments = others.filter((s) => s.data.kind === "event").sort((a, b) => a.data.year - b.data.year);

const moreAbout = site.mainStoriesOf(main.id).filter((s) => s.id !== story.id);
const comingSoon = main.data.angles.filter((a) => !a.story).length;
---
<Base title={`${d.title} | ${main.data.name}`} description={d.subtitle} crumb={main.data.name} crumbHref={hubUrl(main)}>
  <main class="page">
    <Hero
      subject={main}
      label={`${d.type === "flagship" ? "Flagship story" : "Short story"} · ${main.data.name}`}
      heading={d.title}
      dek={d.subtitle}
      quote={d.quote ?? main.data.quote}
      image={d.image ?? main.data.image}
    />

    <QuickFacts subject={main} moments={moments.map((m) => m.data.name)} people={people.map((p) => p.data.name)} />

    <div class="reading">
      <aside class="contents-col">
        {sections.length > 0 && (
          <nav class="contents sticky" aria-label="Contents">
            <span class="label">Contents</span>
            <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>

      <article class="story">
        <div class="story-body"><Content /></div>
        <section class="sources">
          <h2>Where this story comes from</h2>
          <ol>
            {d.sources.map((s) => (
              <li><a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span class="pub">{s.publisher}</span>}</li>
            ))}
          </ol>
        </section>
      </article>

      <aside class="rail">
        <div class="rail-card">
          <span class="label">More about {main.data.name}</span>
          <ul class="people">
            {moreAbout.map((s) => (
              <li><a class="person plain" href={storyUrl(s)}><span><span class="person-name">{s.data.title}</span><span class="person-note">{s.data.type === "flagship" ? "Flagship story" : "Short story"}</span></span></a></li>
            ))}
            <li><a class="person plain" href={hubUrl(main)}><span><span class="person-name">All about {main.data.name}</span><span class="person-note">{comingSoon > 0 ? `${comingSoon} more stories on the way` : "Facts, stories and sources"}</span></span></a></li>
          </ul>
        </div>

        {people.length > 0 && (
          <div class="rail-card">
            <span class="label">People in this story</span>
            <ul class="people">
              {people.map((p) => (
                <li>
                  <a class="person" href={hubUrl(p)}>
                    <span class="avatar">{p.data.image ? <img src={p.data.image.src} alt="" loading="lazy" /> : p.data.name.charAt(0)}</span>
                    <span><span class="person-name">{p.data.name}</span><span class="person-note">{p.data.role}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {moments.length > 0 && (
          <div class="rail-card">
            <span class="label">Moments in this story</span>
            <ul class="people">
              {moments.map((m) => (
                <li>
                  <a class="person" href={hubUrl(m)}>
                    <span class="avatar">{String(m.data.year).slice(2)}</span>
                    <span><span class="person-name">{m.data.name}</span><span class="person-note">{m.data.year}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </main>
</Base>
