---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";
import { loadSite, hubUrl, storyUrl, minutesToRead, datesOf, type Story } from "../../lib/site";

export async function getStaticPaths() {
  const site = await loadSite();
  return site.stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
const site = await loadSite();
const d = story.data;
const { Content } = await render(story);

const main = site.subjectById.get(d.about[0])!;
const cast = d.about.slice(1).map((id) => site.subjectById.get(id)).filter((s) => s !== undefined);
const people = cast.filter((s) => s.data.kind === "person");
const moreAbout = site.mainStoriesOf(main.id).filter((s) => s.id !== story.id);
const planned = main.data.angles.filter((a) => !a.story);
const image = d.image ?? main.data.image;
const minutes = minutesToRead(story.body);
const dates = datesOf(main);
---
<Base title={`${d.title}: a story about ${main.data.name}`} description={d.subtitle}>
  <main class="column">
    <header class="opening">
      <p class="about">
        {d.type === "flagship" ? "The big story" : "A short story"} about <a href={hubUrl(main)}>{main.data.name}</a>{dates && `, ${dates}`}
      </p>
      <h1>{d.title}</h1>
      <p class="question">{d.subtitle}</p>
      <p class="reading-time">About {minutes} minutes to read.</p>
    </header>

    {image && <Plate image={image} portrait />}

    <article class="story"><Content /></article>
    <p class="end-mark" aria-hidden="true">✦</p>

    <section class="after">
      {people.length > 0 && (
        <>
          <h2>Who's who in this story</h2>
          <ul class="whos-who">
            {[main, ...people].map((p) => (
              <li>
                <span class="face">{p.data.image ? <img src={p.data.image.src} alt="" loading="lazy" /> : p.data.name.charAt(0)}</span>
                <span>
                  <a class="who" href={hubUrl(p)}>{p.data.name}</a>
                  <span class="what">{p.data.summary}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )}

      <h2>More about {main.data.name}</h2>
      <p>
        {moreAbout.length > 0 && <>Read next: {moreAbout.map((s, i) => <>{i > 0 && ", "}<a href={storyUrl(s)}>{s.data.title}</a></>)}. </>}
        {planned.length > 0
          ? <>We are writing {planned.length} more stories about {main.data.name}, starting with "{planned[0].title}". </>
          : null}
        Photographs, letters and papers from the time are on <a href={hubUrl(main)}>{main.data.name}'s page</a>.
      </p>

      <h2>Where we found this story</h2>
      <ol class="sources">
        {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.publisher && <span class="pub">. {s.publisher}</span>}</li>)}
      </ol>
    </section>
  </main>
</Base>
