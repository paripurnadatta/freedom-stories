---
import Base from "../layouts/Base.astro";
import { loadSite, storyUrl } from "../lib/site";

const site = await loadSite();
const people = site.subjects.filter((s) => s.data.kind === "person").length;
const planned = site.subjects.reduce((n, s) => n + s.data.angles.filter((a) => !a.story).length, 0);
---
<Base title="The Struggle for Freedom: stories of India, 1757 to 1947">
  <main class="wide">
    <header class="home-open">
      <h1>The Struggle for Freedom<span class="hi">आज़ादी की कहानियाँ</span></h1>
      <p>
        True stories of the people who fought for India's freedom, from the Battle of Plassey in 1757 to Independence in 1947.
        Every story is checked against real records.
      </p>
      <p class="count">{site.stories.length} {site.stories.length === 1 ? "story" : "stories"} so far. {planned} more on the way, and {people} people still waiting for theirs.</p>
    </header>

    <h2 class="chapter-head">Start reading</h2>
    <ol class="contents">
      {site.stories.map((s) => {
        const who = site.subjectById.get(s.data.about[0]);
        return (
          <li class:list={{ flag: s.data.type === "flagship" }}>
            <a href={storyUrl(s)}>
              <span>
                <span class="kind">{who?.data.name}</span>
                <span class="t">{s.data.title}</span>
                <span class="h">{s.data.subtitle}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  </main>
</Base>
