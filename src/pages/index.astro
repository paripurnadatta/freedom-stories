---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const all = await getCollection("stories");
const published = all.filter((s) => s.data.status === "published").sort((a, b) => a.data.year - b.data.year);
---
<Base title="Freedom Stories: India's struggle, 1757 to 1947">
  <main class="wrap">
    <header class="home-head">
      <h1 class="home-title">Freedom Stories</h1>
      <p class="home-lede">
        The people and moments of India's long fight against colonial rule, from Plassey to Independence, told as stories.
      </p>
      <p class="progress">{published.length} of {all.length} stories written so far.</p>
    </header>
    <ol class="index">
      {published.map((s) => (
        <li>
          <a href={`/stories/${s.id}/`}>
            <span class="yr">{s.data.year}</span>
            <span>
              <span class="t">{s.data.title}</span>
              <span class="who">{s.data.name}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</Base>
